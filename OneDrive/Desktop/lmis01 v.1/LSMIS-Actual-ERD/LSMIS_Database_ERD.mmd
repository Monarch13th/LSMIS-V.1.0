erDiagram
    %% LSMIS Physical Database ERD - Supabase PostgreSQL 17.6
    ante_mortem_inspections {
        text id PK
        text livestock_id FK
        text tag_number
        text species
        text inspector_name
        date date
        text findings
        text decision
        text remarks
        timestamptz inspected_at
        text inspector_id
        text created_by_user_id
    }

    audit_logs {
        text id PK
        text user
        text role
        text action
        text module
        text timestamp
        text ip
        text tag_number
        text old_value
        text new_value
        text field_changed
        text security_event
        text severity
        text user_id
        timestamptz created_at
    }

    carcass_branding_records {
