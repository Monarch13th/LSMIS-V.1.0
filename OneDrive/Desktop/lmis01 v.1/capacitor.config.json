{
  "appId": "ph.gov.nagacity.lsmis",
  "appName": "LSMIS",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "url": "https://lsmis.vercel.app",
    "androidScheme": "https",
    "allowNavigation": [
      "lsmis.vercel.app",
      "*.vercel.app",
      "zwuoebmkapoywkpyaahw.supabase.co",
      "*.supabase.co",
      "accounts.google.com",
      "*.google.com",
      "*.googleapis.com",
      "*.gstatic.com"
    ]
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": true,
      "backgroundColor": "#ffffff",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_INSIDE",
      "showSpinner": false,
      "splashFullScreen": false,
      "splashImmersive": false
    }
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  }
}
