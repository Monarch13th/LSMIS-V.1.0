{
  "appId": "ph.gov.nagacity.lsmis",
  "appName": "LSMIS",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "url": "https://lsmis.vercel.app",
    "androidScheme": "https",
    "allowNavigation": [
      "lsmis.vercel.app",
      "*.vercel.app",
      "zwuoebmkapoywkpyaahw.supabase.co",
      "*.supabase.co",
      "accounts.google.com",
      "*.google.com",
      "*.googleapis.com",
      "*.gstatic.com"
    ]
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 0,
      "launchAutoHide": true,
      "backgroundColor": "#ffffff",
      "androidSplashResourceName": "splash",
      "showSpinner": false
    }
  }
}
